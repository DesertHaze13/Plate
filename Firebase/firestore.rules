rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid}/{collection}/{document} {
      allow read: if owner(uid) && collection in ['profile', 'goals', 'settings', 'meals', 'days', 'myFoods', 'weights', 'photos'];
      allow write: if owner(uid) && collection in ['profile', 'goals', 'settings', 'myFoods', 'weights'];
      allow create, update: if owner(uid) && collection == 'meals'
        && request.resource.data.id == document
        && request.resource.data.timestamp is timestamp
        && request.resource.data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100;
      allow delete: if owner(uid) && collection == 'meals';
      allow create, update: if owner(uid) && collection == 'photos'
        && request.resource.data.bytes is bytes
        && request.resource.data.bytes.size() <= 768000
        && request.resource.data.contentType == 'image/jpeg';
      allow delete: if owner(uid) && collection == 'photos';
      // On Spark, the app derives totals from live meals; only a future trusted function writes day caches.
    }
  }
}
